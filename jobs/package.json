{
  "name": "@crammer/jobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "worker": "tsx src/worker.ts",
    "trigger:dev": "trigger.dev dev"
  },
  "dependencies": {
    "@crammer/db": "workspace:*",
    "@crammer/pipeline": "workspace:*",
    "@crammer/providers": "workspace:*",
    "@crammer/schema": "workspace:*",
    "@supabase/storage-js": "2.117.1",
    "@trigger.dev/sdk": "4.6.4",
    "resend": "6.28.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@crammer/video": "workspace:*",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
