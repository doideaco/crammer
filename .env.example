# ---- M1 (CLI) ----
ANTHROPIC_API_KEY=
CRAMMER_MODEL=claude-opus-5
# Only needed when the API key is not scoped to a single workspace.
ANTHROPIC_WORKSPACE_ID=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Required by Wikimedia API policy, e.g. "Crammer/0.1 (you@example.com)"
WIKIMEDIA_USER_AGENT=Crammer/0.1 (you@example.com)

# Optional: set to 1 to run the whole pipeline against mock providers (no network, no cost)
CRAMMER_MOCK=

# ---- M2+ ----
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TRIGGER_SECRET_KEY=
RESEND_API_KEY=

# ---- M3+ ----
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
