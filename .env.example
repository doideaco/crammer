# ---- M1 (CLI) ----
ANTHROPIC_API_KEY=
CRAMMER_MODEL=claude-opus-5
# Only needed when the API key is not scoped to a single workspace.
ANTHROPIC_WORKSPACE_ID=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Required by Wikimedia API policy, e.g. "Crammer/0.1 (you@example.com)"
WIKIMEDIA_USER_AGENT="Crammer/0.1 (you@example.com)"

# Optional: set to 1 to run the whole pipeline against mock providers (no network, no cost)
CRAMMER_MOCK=

# ---- M2: web app, database, jobs ----
# `supabase start` prints all of these; `supabase status -o env` prints them again.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The browser needs its own copies. `pnpm sync:env` copies these into
# apps/web/.env.local, which is the file Next.js actually reads.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Without TRIGGER_SECRET_KEY the local polling worker runs the jobs, which is
# a supported way to run M2 rather than a degraded one.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Optional. Without it, the "your video is ready" mail is written to the worker log.
RESEND_API_KEY=
CRAMMER_EMAIL_FROM=

# Where the local artefact store keeps files, when Supabase Storage is not configured.
CRAMMER_MEDIA_ROOT=

# ---- M3+ ----
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
